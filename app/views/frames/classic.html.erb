<%= ui.body(:classic) do %>
  <%= elements.main_menu(preset: :primary_horizontal, as: :header, prepend: app_banner) %>

  <main class="ui fluid container" style="flex: 1; padding: 1rem 0;">
    <%= elements.breadcrumb %>
    <%= @page_title %>
    <%= yield %>
  </main>

  <footer class="ui inverted vertical footer segment">
    <div class="ui center aligned container">
      &copy; Torque Admin <%= Date.current.year %>
    </div>
  </footer>
<% end %>
