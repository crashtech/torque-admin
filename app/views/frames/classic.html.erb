<%- settings = { class: ['classic', app_body_classes], style: { 'min-height' => '100svh' } } -%>
<%= ui.rows('min-content', 'min-content', '1fr', 'min-content', as: :body, **settings) do %>
  <%= elements.main_menu(preset: :primary_horizontal, as: :header, prepend: app_banner) %>
  <%= app_page_banner %>
  <%= app_page_content { yield } %>
  <%= app_page_footer %>
<% end %>
