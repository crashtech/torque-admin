<%= ui.body(:modern) do %>
  <%= elements.secondary_menu(preset: :secondary_horizontal, as: :header, prepend: app_banner) %>

  <main style="flex: 1; display: flex;">
    <%= elements.main_menu(preset: :primary_vertical, as: :section) %>

    <div style="flex: 1; display: flex; flex-direction: column;">
      <div style="flex: 1; padding: 2rem;">
        <%= elements.breadcrumb %>
        <%= yield %>
      </div>

      <footer class="ui vertical inverted footer segment">
        <div class="ui center aligned container">
          Copyright &copy; 2024
        </div>
      </footer>
    </div>
  </main>
<% end %>
