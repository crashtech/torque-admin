<%- settings = { class: ['sidebar', app_body_classes], style: { 'min-height' => '100svh' } } -%>
<%= ui.columns('min-content', '1fr', as: :body, gap: nil, **settings) do %>
  <%= elements.main_menu(preset: :primary_vertical, prepend: app_banner) %>
  <%= ui.rows('min-content', '1fr', 'min-content', style: { 'padding-top' => ui.settings[:default_gap] }) do %>
    <%= app_page_banner %>
    <%= app_page_content { yield } %>
    <%= app_page_footer %>
  <% end %>
<% end %>
