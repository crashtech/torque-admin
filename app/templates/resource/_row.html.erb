<%# locals: (primary_element:, **) -%>
<%- require_local!(table = primary_element.settings(:as, :table)) -%>
<%- require_local!(type = primary_element.settings(:source_type, :record).to_s.tr('/', '_')) -%>

<%- if primary_element.row_callbacks? -%>
<%- else -%>
<tr id="<%= append "#{table}.row_dom_id(#{type})" %>">
  <%- primary_element.columns.each do |column| -%>
  <td><%== "<%= #{table}.value_for(#{type}, #{column.id.inspect}) %" + '>' %></td>
  <%- end -%>
</tr>
<%- end -%>
